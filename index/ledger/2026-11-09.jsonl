{"ev": "seen", "ts": "2026-11-09T08:09:07Z", "actor": "sports", "story": {"id": "st-1e07fea3ee6d", "date": "2026-11-09", "stream": "sports", "headline": "Alcaraz wins Paris Masters", "summary": "Alcaraz beat Shelton 7-6, 7-5 for his first Paris title.", "url": "https://www.srf.ch/sport/tennis/atp-tour/shelton-in-2-saetzen-geschlagen-nervenstarker-alcaraz-gewinnt-erstmals-in-der-halle-in-paris", "source_domain": "srf.ch", "tier": "T2", "tags": [], "topics": ["sports"], "importance": 2, "display_body": "Carlos Alcaraz (ranked 3) beat Ben Shelton (ranked 4), saving a string of break points in the first set before winning a tiebreak, then breaking twice from behind in the second. SRF counts it as his seventh Masters 1000 title of the nine on the calendar; only the Canadian Open and Shanghai are missing. It follows his title in Vienna two weeks earlier and avenges Shelton's win over him in the US Open quarterfinals. Gauff opened the WTA Finals in Indian Wells with a three-set win over Pegula on 2026-11-09.", "why": "Alcaraz arrives at the season-ending finals in top form after a comeback from injury.", "thread_id": "2026-11-09-sports-alcaraz-wins-paris-masters", "first_seen_date": "2026-11-09", "event_date": "2026-11-08", "embedding_model": "bge-m3", "emb": "", "entities": ["Carlos Alcaraz", "Ben Shelton"], "status": "settled", "first_seen": "2026-11-09T08:09:07Z", "updated": "2026-11-09T08:09:07Z", "legacy_ids": ["2026-11-09-sports-alcaraz-wins-paris-masters"], "editions": ["2026-11-09-sports"], "origin": "writer:sports", "streams": ["sports"]}}
