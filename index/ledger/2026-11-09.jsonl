{"ev": "seen", "ts": "2026-11-09T08:09:07Z", "actor": "sports", "story": {"id": "st-812a1e17cd6f", "date": "2026-11-09", "stream": "sports", "headline": "Swiss hockey loses all three", "summary": "Switzerland lost all three Euro Hockey Tour games in Helsinki.", "url": "https://www.srf.ch/sport/eishockey/nationalmannschaft/euro-hockey-tour-in-helsinki-von-wegen-wiedergutmachung-schweiz-unterliegt-auch-tschechien", "source_domain": "srf.ch", "tier": "T2", "tags": [], "topics": ["sports"], "importance": 1, "display_body": "After losing 1–3 to Finland and 2–4 to Sweden, Switzerland led the Czechs 2–0 after the first period and still lost 2–4, finishing with zero points and a 5–11 goal difference. SRF notes the team has not won a game since its 6–0 win over Norway on 2026-05-30, and coach Jan Cadieux's squad is young. This is a preseason-style check-in, not a medal event, so one slump does not decide anything on its own.", "why": "a long winless run before the next major tournament is the kind of thing a young team needs to address early.", "thread_id": "2026-11-09-sports-swiss-hockey-loses-all-three", "first_seen_date": "2026-11-09", "event_date": "2026-11-08", "embedding_model": "bge-m3", "emb": "", "entities": ["Switzerland national ice hockey team"], "status": "settled", "first_seen": "2026-11-09T08:09:07Z", "updated": "2026-11-09T08:09:07Z", "legacy_ids": ["2026-11-09-sports-swiss-hockey-loses-all-three"], "editions": ["2026-11-09-sports"], "origin": "writer:sports", "streams": ["sports"]}}
