{"ev": "seen", "ts": "2026-07-26T10:10:52Z", "actor": "news", "story": {"id": "st-07fa7b3f4e3c", "date": "2026-07-26", "stream": "news", "headline": "Tunisians protest five years of Saied rule", "summary": "Thousands rallied in Tunis on 25 July marking five years since President Saied suspended parliament, demanding he step down.", "url": "https://www.aljazeera.com/news/2026/7/26/tunisians-mark-fifth-year-of-emergency-rule-with-calls-for-saied-to-go", "source_domain": "aljazeera.com", "tier": "T2", "tags": [], "topics": ["geopolitics", "politics"], "importance": 1, "display_body": "Thousands marched in Tunis on Saturday 25 July, marking five years since President Kais Saied suspended parliament and began ruling by decree, and calling for the \"fall of the regime.\" Crowds filled the central Habib Bourguiba Avenue in the latest of a run of protests against crackdowns on dissent, jailed opposition figures, and a struggling economy.", "why": "", "thread_id": "2026-07-26-news-tunisians-protest-five-years-of-saied-rule", "first_seen_date": "2026-07-26", "event_date": "2026-07-25", "embedding_model": "bge-m3", "emb": "", "entities": ["Tunisia", "Kais Saied"], "status": "settled", "first_seen": "2026-07-26T10:10:52Z", "updated": "2026-07-26T10:10:52Z", "legacy_ids": ["2026-07-26-news-tunisians-protest-five-years-of-saied-rule"], "editions": ["2026-07-26-news"], "origin": "writer:news", "streams": ["news"]}}
