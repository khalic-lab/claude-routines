{"ev": "seen", "ts": "2026-08-02T10:10:20Z", "actor": "news", "story": {"id": "st-1ef213b5877c", "date": "2026-08-02", "stream": "news", "headline": "Nazca tourist plane crash kills 13", "summary": "A tourist plane over Peru's Nazca Lines crashed, killing all 13 aboard.", "url": "https://www.france24.com/en/americas/20260802-peru-tourist-plane-crashes-killing-all-13-people-aboard", "source_domain": "france24.com", "tier": "T2", "tags": [], "topics": ["world"], "importance": 1, "display_body": "A tourist plane crashed over Peru's Nazca Lines on Saturday (1 August), killing all 13 people aboard. The light aircraft, of the type that flies sightseers over the ancient desert geoglyphs, went down for reasons not yet established.", "why": "", "thread_id": "2026-08-02-news-nazca-tourist-plane-crash-kills-13", "first_seen_date": "2026-08-02", "event_date": "2026-08-01", "embedding_model": "bge-m3", "emb": "", "entities": ["Peru", "Nazca Lines"], "status": "settled", "first_seen": "2026-08-02T10:10:20Z", "updated": "2026-08-02T10:10:20Z", "legacy_ids": ["2026-08-02-news-nazca-tourist-plane-crash-kills-13"], "editions": ["2026-08-02-news"], "origin": "writer:news", "streams": ["news"]}}
